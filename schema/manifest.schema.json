{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moxiaoqin12345/12345/schema/manifest.schema.json",
  "title": "TCM-Library manifest",
  "description": "Machine-readable master inventory, deterministically generated by scripts/build_manifest.py. The engine loads this file once; RAG pipelines consume its entries array directly.",
  "type": "object",
  "required": ["schema_version", "name", "match_fields", "match_rule", "roots",
               "categories", "books", "total", "entries"],
  "properties": {
    "schema_version": { "type": "number", "const": 2.1 },
    "name": { "type": "string" },
    "match_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "结构化召回维度（除 keywords 外的 conditions 字段）"
    },
    "match_rule": { "type": "string", "description": "匹配语义：组内 AND、维度间 OR；结果按命中特异性 → weight → path 排序" },
    "roots": {
      "type": "object",
      "description": "分类层级：{ category: { subcategory: { dir, count } } }",
      "additionalProperties": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "name_zh", "subcategories"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "name_zh": { "type": "string" },
          "subcategories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "name_zh"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "name_zh": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dir", "tier", "tier_name", "category", "subcategory", "count"],
        "properties": {
          "dir": { "type": "string", "description": "relative path to book dir" },
          "tier": { "type": "integer", "description": "梯队 1-3，1=核心" },
          "tier_name": { "type": "string" },
          "category": { "type": "string" },
          "subcategory": { "type": "string" },
          "count": { "type": "integer" }
        }
      }
    },
    "total": { "type": "integer", "description": "全库条目总数" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "book", "type", "tier", "category", "subcategory", "path", "weight", "title", "chapter", "conditions"],
        "properties": {
          "id": { "type": "string" },
          "book": { "type": "string" },
          "type": { "type": "string" },
          "tier": { "type": "integer" },
          "category": { "type": "string" },
          "subcategory": { "type": "string" },
          "path": { "type": "string", "description": "relative path to entry .md" },
          "weight": { "type": "integer", "minimum": 0, "maximum": 10 },
          "title": { "type": "string" },
          "chapter": { "type": "string" },
          "conditions": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
